{
  "name": "daom-fyaf-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio Web Oficial del Gimnasio de Fuerza y Acondicionamiento Físico (FyAF) - Club DAOM",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "build:worker": "node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "wrangler": "^4.161.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
