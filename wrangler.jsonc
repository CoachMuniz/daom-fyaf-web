{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daom-fyaf-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "FYAF_MEDIA_STORE",
      "id": "3a5da6e21efd441ba164a4005ede9fa5"
    },
    {
      "binding": "FYAF_MEDIA_BLOBS",
      "id": "b246015238db4f4da42dee9b58747213"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "GOOGLE_SHEETS_ID": "1a0uzrxAhvXyOn0wjDxwnTWU1EC9BWT3Xr2Q3GFkDvP4",
    "NEXT_PUBLIC_SITE_URL": "https://gimnasio.daom.club"
  }
}
